<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.shortName }}{% else %}{{ site.name }} — learn words by solving puzzles{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="apple-itunes-app" content="app-id={{ site.appId }}">
  <meta property="og:type" content="{% if layout == 'post.njk' or tags and 'posts' in tags %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.shortName }}">
  {# Pages may carry their own preview card (the /a/ answer pages do — a
     per-class night-sky card beats the home screenshot under a quiz reply);
     everything else keeps the site-wide og.jpg. #}
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/img/og.jpg' }}">
  {% if ogImage %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/atom+xml" title="{{ site.shortName }} blog" href="/feed.xml">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    // PostHog — only on the live domain so localhost previews never pollute analytics.
    if (location.hostname === "lexivocab.app" || location.hostname === "www.lexivocab.app") {
      var phs = document.createElement("script");
      phs.async = true;
      phs.src = "https://us-assets.i.posthog.com/static/array.js";
      phs.onload = function () {
        window.posthog && window.posthog.init("phc_CG4yS3uf8rL5JXWMUBCihtAdcvStyiUDQxJ5NJ7UHPrP", {
          api_host: "https://us.i.posthog.com",
          defaults: "2026-05-30"
        });
      };
      document.head.appendChild(phs);
    }
  </script>
</head>
<body>
  <header class="nav">
    <a class="wordmark" href="/">Lexi</a>
    <nav>
      <a href="/premium/">Premium</a>
      <a href="/blog/">Blog</a>
      <a class="btn btn-small" href="{{ site.appstore }}">Get the app</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>
      <a href="{{ site.appstore }}">{{ site.name }}</a> — free on the App Store ·
      <a href="/premium/">Premium</a> ·
      <a href="/blog/">Blog</a> ·
      <a href="/feed.xml">RSS</a> ·
      <a href="/privacy/">Privacy</a> ·
      <a href="/terms/">Terms</a>
    </p>
    <p class="muted">Made by a solo developer who wanted a vocabulary app he'd actually keep opening.</p>
  </footer>
</body>
</html>
