// Cloudflare Workers config: serve the built 11ty site (_site) as static
// assets on wordlab.nz, behind worker.js (old-domain and www redirects).
// The Workers Builds integration runs `npm run build` then
// `npx wrangler deploy`, which reads this file.
{
  "name": "leximarketing",
  "main": "worker.js",
  "compatibility_date": "2026-07-03",
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request meets worker.js first, so lexivocab.app can redirect
    // even where a file exists at the same path.
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "wordlab.nz", "custom_domain": true },
    { "pattern": "www.wordlab.nz", "custom_domain": true },
    { "pattern": "lexivocab.app", "custom_domain": true },
    { "pattern": "www.lexivocab.app", "custom_domain": true }
  ]
}
